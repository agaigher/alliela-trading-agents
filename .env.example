# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=

# Optional: point at a remote Ollama server. When unset, defaults to
# the local instance at http://localhost:11434/v1. Convention follows
# the broader Ollama ecosystem; both the CLI dropdown and programmatic
# client pick this up.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Optional: override DEFAULT_CONFIG without editing code.
# Any TRADINGAGENTS_* variable below, when set, replaces the matching key
# in tradingagents/default_config.py. Values are coerced to the type of
# the existing default (bool / int / str), so "true"/"3" work as expected.
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.4
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_CHECKPOINT_ENABLED=false

# Per-agent model overrides as a JSON object (agent key -> model name).
# Agents not listed fall back to the quick/deep tier defaults above.
# Most useful with the openrouter provider, where one OPENROUTER_API_KEY
# exposes every major lab's models under namespaced IDs. Valid keys:
# market_analyst, sentiment_analyst, news_analyst, fundamentals_analyst,
# bull_researcher, bear_researcher, research_manager, trader,
# aggressive_analyst, conservative_analyst, neutral_analyst,
# portfolio_manager, reflector, signal_processor.
#TRADINGAGENTS_LLM_PROVIDER=openrouter
#TRADINGAGENTS_DEEP_THINK_LLM=openai/gpt-5.4
#TRADINGAGENTS_QUICK_THINK_LLM=openai/gpt-5.4-mini
#TRADINGAGENTS_AGENT_MODELS={"research_manager": "anthropic/claude-opus-5", "market_analyst": "google/gemini-3-flash"}
